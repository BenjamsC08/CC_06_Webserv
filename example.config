server {    
listen 8080,8082,8070
name machin
max_body_size 2M
cgi ".py" "/usr/bin/python3"
cgi ".php" "/usr/bin/php-cgi"
cgi ".txt" "/usr/bin/cat"
cgi ".sh" "/usr/bin/bash"
cgi ".other" "/noExec"
error 400 ./assets/error/400.html
error 401 ./assets/error/401.html
error 403 ./assets/error/403.html
error 404 ./assets/error/404.html
error 405 ./assets/error/405.html
error 408 ./assets/error/408.html
error 411 ./assets/error/411.html
error 413 ./assets/error/413.html
error 415 ./assets/error/415.html
error 500 ./assets/error/500.html
error 502 ./assets/error/502.html
error 504 ./assets/error/504.html
location / {
    methods GET,POST
    methods GET,POST
    root /assets/pages
    listing disable;
    nolisting_path index.html
    # if no listing of and no path set to `nolisting_path` a default page will be used and return a 404
    upload on
    upload_path /tmp/truc
}
location /cgi-bin {
    methods POST,GET
    root ./CGI_scripts
    listing enable;
    upload disable
}
location /upload {
    methods DELETE,GET,POST
    root /assets/upload
    listing disable;
    upload enable
    upload_path ./assets/upload
}
location /machin {
    methods GET
    root /assets/dirs
    listing enable;
    upload disable
}
location /redir {
    methods GET
    return https://www.youtube.com/watch?v=dQw4w9WgXcQ
	root /assets/dirs
    listing enable;
    upload disable
}
}

server {
listen 4500
default
cgi ".py" "/truc/bidule"
error 404 ./default/404.html
error 405,406 ./default/default_error_page.html		#important
location / {
    methods GET,POST
    root /assets/pages
    listing disable;
    nolisting_path index.html
    upload enable
    upload_path /tmp/truc
}
location /machin {
    methods POST, DELETE
    root ./tmp/www
    listing enable;
    upload disable
    cgi ".txt" "/bin/cat"
    cgi ".py" ""
}
}

#Server:
# listen
# error
# location
#HttpRule:
# root
# listing (if enabled display an html with tree file from SERVER_PATH)
# nolisting_path **depends if listing is disable
# upload
# upload_path **depends if upload is enabled
#
